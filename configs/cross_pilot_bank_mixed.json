{
  "profile": "cross_pilot_bank_mixed",
  "seeds": [0, 1, 2],
  "environments": {
    "tmaze": {"interactions": 6000, "conditions": ["raw", "matched"], "bank": "mixed", "kwargs": {"corridor_length": 5}, "threshold": 0.8},
    "ringworld": {"interactions": 6000, "conditions": ["raw", "matched"], "bank": "mixed", "kwargs": {"size": 12}, "threshold": 0.8},
    "two_loop": {"interactions": 7000, "conditions": ["raw", "matched"], "bank": "mixed", "kwargs": {"loop_lengths": [8, 10]}, "threshold": 0.8},
    "hidden_velocity": {"interactions": 9000, "conditions": ["raw", "matched"], "bank": "mixed", "kwargs": {"noise_std": 0.015}, "control_alpha": 0.002, "gamma": 0.95, "threshold": -0.3}
