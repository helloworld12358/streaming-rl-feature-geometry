    "ringworld": {"interactions": 600, "conditions": ["observation_only", "raw", "matched", "oracle"], "bank": "mixed", "kwargs": {"size": 12}, "threshold": 0.8},
    "two_loop": {"interactions": 600, "conditions": ["observation_only", "raw", "matched", "oracle"], "bank": "mixed", "kwargs": {"loop_lengths": [8, 10]}, "threshold": 0.8},
    "hidden_velocity": {"interactions": 600, "conditions": ["observation_only", "raw", "matched", "oracle"], "bank": "mixed", "kwargs": {"noise_std": 0.015}, "control_alpha": 0.002, "gamma": 0.95, "threshold": -0.3}
